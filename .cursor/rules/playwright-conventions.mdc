## 5. Test data

**Standard:** Faker factories under `test-data/factories/` for happy-path entities; curated invalid sets in static `test-data/invalid/*.ts`; secrets and base URLs from `process.env`; repeated routes, labels, and messages from `test-data/enums/`; import `test` from `fixtures/cleanup.fixture.ts`; call `trackProgram(uuid)` / `trackUser(id)` after every create.

✅ **Good** — factory + enum + fixture cleanup:

```typescript
import { test, expect } from '../fixtures/cleanup.fixture';
import { buildProgram } from '../test-data/factories/program.factory';
import { INVALID_PROGRAM_NAMES } from '../test-data/invalid/program-names';
import { AppRoute } from '../test-data/enums/routes';

test('TC-003 — Create program', { tag: '@smoke' }, async ({ trackProgram, page }) => {
  const { name, description } = buildProgram();
  await page.goto(AppRoute.Programs);
  await programsPage.createProgram(name, trackProgram, { description });
  await expect(programsPage.programRow(name)).toBeVisible();
});

test('TC-006 — Whitespace-only name rejected', { tag: '@regression' }, async () => {
  await programsPage.fillProgramName(INVALID_PROGRAM_NAMES.whitespaceOnly);
  await expect(programsPage.newProgramModal.createButton).toBeDisabled();
});
```

Example factory (`test-data/factories/program.factory.ts`):

```typescript
import { faker } from '@faker-js/faker';

export function buildProgram(overrides: Partial<ProgramSeed> = {}): ProgramSeed {
  const suffix = faker.string.alphanumeric(8);
  return {
    name: `QA Program ${suffix}`,
    description: faker.lorem.sentence(),
    ...overrides,
  };
}
```

❌ **Bad:**

```typescript
import { test, expect } from '@playwright/test';   // skips cleanup fixture
const programName = 'Web Development 2026';         // static — collides under fullyParallel
const token = 'eyJhbGciOiJIUzI1NiIs…';           // hardcoded secret
await page.goto('https://test.didaxis.studio/programs'); // magic URL string
// create program but never trackProgram(uuid)
```

**Why:** Factories isolate uniqueness; static invalid sets are reviewable; enums stop route/copy drift; env vars keep secrets out of source; missing `trackProgram` leaves orphan data.

