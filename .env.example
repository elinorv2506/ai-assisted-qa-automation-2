# =============================================================================
# Run tests
# Required to clone the repo and run `npx playwright test` locally or in CI.
# Copy this file to `.env` and replace placeholders — never commit `.env`.
# =============================================================================

# Base URL of the Didaxis environment under test (Playwright baseURL).
DIDAXIS_URL=https://test.didaxis.studio

# Admin account email — used once by tests/auth.setup.ts to build storageState.
DIDAXIS_EMAIL=your-admin@example.com

# Admin account password — paired with DIDAXIS_EMAIL for setup login.
DIDAXIS_PASSWORD=your-admin-password-here

# Bearer token for REST API calls (cleanup fixture, contract checks).
# Prefer this over login when calling /api/* from tests or scripts.
DIDAXIS_API_TOKEN=your-bearer-token-here

# --- Optional: permission probes ---------------------------------------------
# Secondary (non-admin) account for role/permission scenarios. Leave unset if unused.

# Viewer or editor email for multi-user / permission tests.
DIDAXIS_ALT_EMAIL=your-viewer@example.com

# Password for the alternate account above.
DIDAXIS_ALT_PASSWORD=your-viewer-password-here

# =============================================================================
# Agent / CI setup
# Not needed for `npx playwright test` alone. Used by the headless Cursor agent
# in .github/workflows/test-generation.yml and by Jira/Confluence MCP in Cursor.
# Add these as GitHub Actions secrets for CI; MCP tokens live in Cursor settings.
# =============================================================================

# Cursor API key for the `agent` CLI in test-generation.yml.
CURSOR_API_KEY=your-cursor-api-key-here

# Atlassian API token (https://id.atlassian.com/manage-profile/security/api-tokens).
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here

# Jira/Confluence site URL, e.g. https://your-org.atlassian.net
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=your-atlassian@example.com
